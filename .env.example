# Base panel API — local/dev config. Copy to .env and adjust.
APP_ENV=local

# Extra allowed CORS origins (comma-separated). ONE OF THREE LAYERS, and they
# are UNIONED, never overridden (see Service\CorsConfig):
#   1. the hardcoded first-party baseline — the *.tracht-digital.de production
#      surfaces (marketing site, blog, management, app, tools, auth) are always
#      allowed, so the frontends + the live-chat-cta widget work even if this
#      file is unset or stale;
#   2. this key;
#   3. whatever an admin adds under Einstellungen → „CORS / Freigegebene
#      Origins", stored in the database.
#
# Layer 3 is the one to use on a running host: this file needs SSH, which the
# Plesk install model does not have. This key stays as the fallback so an
# existing deployment behaves exactly as before. Union rather than override,
# because an admin who removed the origin their own panel runs on would have no
# surface left to undo it from.
CORS_ALLOWED_ORIGINS=http://localhost:4321

# Auth — tds-auth-api base URL; the core fetches its JWKS to verify RS256 JWTs
# and build the request UserContext. Unset → every request is anonymous (routes
# then 401), so boot/local dev works without auth-api.
AUTH_API_URL=https://api.tracht-digital.de/auth
JWKS_CACHE_TTL=600

# DB — the shared PDO connection modules store their tables through (lazy, so
# boot stays DB-free until a route touches it).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tds_core_panel
DB_USER=root
DB_PASS=

# Core SMTP — the Mailer exposed to modules. These are the FALLBACK now: the
# panel writes host/port/user/password/from into the runtime settings store
# (namespace `mail`, Einstellungen → E-Mail (SMTP)) and a stored configuration
# WINS over MAIL_DSN. Leave these unset on a host that is configured from the
# panel; with neither, the mailer is a no-op (modules can still call it;
# isConfigured() is false). DSN form: smtp://user:pass@host:port
#
# QUOTE any value containing a space (see MAIL_FROM_NAME below). phpdotenv
# rejects a bare unquoted spaced value, and Bootstrap::createApp() loads the
# .env before anything else — so one such line kills the WHOLE service at boot,
# surfacing as `"/frontend": {"status": 0}` in the gateway's /healthz and a
# `500 Slim Application Error` on every route, with nothing in the app log.
MAIL_DSN=
MAIL_FROM=no-reply@tracht-digital.de
MAIL_FROM_NAME="Tracht Digital Solutions"

# Runtime settings store — the key that AES-256-GCM-encrypts SECRET settings at
# rest (DeepL keys, rebuild tokens, …) in the shared app_setting table. Use a
# long random string; keep it stable (rotating it makes stored secrets
# undecryptable). Unset → non-secret settings still work; secrets can't be stored.
SETTINGS_ENCRYPTION_KEY=

# Site keys — what happens to a PUBLIC SITE-READ route (/content/*,
# /tools/catalog; each module declares its own) reached WITHOUT a valid key:
#   off     — nothing. The default, and the behaviour of every deployment that
#             predates this feature.
#   warn    — served, but counted and logged, so the panel can report how many
#             keyless reads happened while keys are being rolled out.
#   enforce — 401.
#
# Only a FALLBACK: the panel writes this into the runtime settings store
# (namespace `sites`, Einstellungen → Site-Verbindungen) and a stored value
# wins. Do NOT jump from off to enforce — a rejected build-time fetch is
# fail-soft on the other end, so the site renders its baked fallbacks and
# reports success. `warn` is what makes the gap visible first.
#
# The keys themselves live in the app_site_key table as SHA-256 hashes and are
# issued in the panel; there is deliberately no env var holding one.
SITE_KEY_ENFORCEMENT=off

# Public-site page-cache rebuild. Both values are OPTIONAL FALLBACKS: the CMS
# settings screens store them encrypted in the runtime SettingsStore first
# (`blog-cms/cache_token`, `website-cms/cache_token`). Leave them empty when the
# tokens are configured in the panel; with neither layer, content saves still
# succeed and simply skip the page-cache notification.
BLOG_CACHE_TOKEN=
WEBSITE_CACHE_TOKEN=

# Documents extension. DOCUMENT_ROOT_DIR is the directory customer documents are
# read from and written to; DOCUMENT_SIGN_SECRET signs the time-limited download
# links so a URL cannot be shared onward indefinitely.
#
# The gateway's /install.php has written both of these since the documents
# surface moved into the composed frontend — this file did not list them, which
# is precisely the drift scripts/check-env-parity.php now fails the assemble on.
DOCUMENT_ROOT_DIR=
DOCUMENT_SIGN_SECRET=

# Support-tickets extension. ALL of these are only a FALLBACK: since the
# mailbox became panel-configurable they are read from the runtime settings
# store first (namespace `support-tickets`, Einstellungen → Support-Tickets →
# E-Mail-Eingang). They exist so a host that was configured through this file
# keeps working, and so a mailbox can be set up before the panel is reachable.
#
# The connection fields follow IMAP_HOST all or nothing — a mailbox configured
# in the panel never takes single fields from here, because a half-and-half
# mailbox produces a login failure with no explicable cause. TICKET_INGEST_MODE:
# off | reply (default; thread replies only) | allowlist | all. Widening it is
# deliberately an act in the panel: an address that receives mail also receives
# spam. IMAP_SECURITY: ssl (993) | tls (143, STARTTLS) | none.
#
# GET /admin/tickets/imap reports which layer is actually in use (db|env|none).
TICKET_ADMIN_EMAIL=
TICKET_UPLOAD_DIR=
INGEST_TOKEN=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SECURITY=ssl
IMAP_FOLDER=INBOX
TICKET_INGEST_MODE=reply
TICKET_INGEST_MATCH_COMPANY=1
